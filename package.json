{
  "name": "ai-proxy",
  "version": "3.0.4",
  "description": "OpenAI-compatible AI proxy with Lsqlite persistence, traceable request logs, and admin console",
  "main": "dist/http/server.js",
  "type": "commonjs",
  "scripts": {
    "build": "npm run build:server && npm run build:web",
    "build:server": "tsc -p tsconfig.json",
    "build:web": "vite build --config web/vite.config.ts",
    "dev": "tsx watch src/http/server.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "start": "node dist/http/server.js",
    "db:migrate": "tsx src/db/migrate-cli.ts",
    "test": "node --test --import tsx test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit"
  },
  "license": "MIT",
  "dependencies": {
    "cors": "2.8.5",
    "dotenv": "17.3.1",
    "express": "5.2.1",
    "express-session": "1.18.1",
    "openai": "4.104.0"
  },
  "devDependencies": {
    "@ant-design/icons": "5.6.1",
    "@types/cors": "2.8.17",
    "@types/express": "5.0.0",
    "@types/express-session": "1.18.1",
    "@types/node": "22.13.1",
    "@types/pg": "^8.11.10",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "4.3.4",
    "antd": "5.23.4",
    "antd-mobile": "5.38.1",
    "dayjs": "^1.11.13",
    "framer-motion": "11.18.2",
    "pg": "^8.13.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-markdown": "9.0.3",
    "react-router-dom": "6.29.0",
    "tsx": "4.19.2",
    "typescript": "5.7.3",
    "vite": "6.0.11"
  }
}