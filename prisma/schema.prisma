generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Provider {
  id       Int      @id @default(autoincrement())
  name     String   @unique
  baseUrl  String
  apiKey   String
  models   Json     @default("[]")
  rule     String   @default("priority")
  priority Int      @default(0)
  enabled  Boolean  @default(true)
  isEnv    Boolean  @default(false)
  isContributed Boolean @default(false)
  stats    Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}