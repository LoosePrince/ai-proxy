# ---------------------------------------------------------------- 数据库
# Lsqlite 远程 SQL 服务。表结构由服务启动时自动迁移，无需手工建表。
LSQLITE_URL=https://lsqlite.xzt.plus
LSQLITE_KEY=
# 单条 SQL 的 HTTP 超时
LSQLITE_TIMEOUT_MS=15000

# ---------------------------------------------------------------- 服务
PORT=3000

# 管理后台账号。两者都留空则后台不设登录门禁（仅建议内网使用）。
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Session 密钥，生产环境务必更换
SESSION_SECRET=ai-proxy-session-secret

# ---------------------------------------------------------------- 配置种子
# 以下变量只在 settings 表首次初始化时作为种子值写入。
# 之后一律以数据库为准，改这里不会覆盖后台的修改。
DEFAULT_RESPONSE_TIMEOUT_MS=30000
FALLBACK_RESPONSE_TIMEOUT_MS=30000
PARALLEL_RESPONSE_TIMEOUT_MS=14000
# 同 IP 每分钟请求数上限，0 表示不限流
IP_RATE_LIMIT_RPM=20
# 请求明细保留天数，0 表示永不清理（日聚合数据永久保留，不受此项影响）
LOG_RETENTION_DAYS=0
# JSON 对象，key 为 priority，value 为毫秒数。迁移到 priority_groups.timeout_ms
PRIORITY_RESPONSE_TIMEOUTS={"0":20000,"1":35000}

# ---------------------------------------------------------------- Provider
# 启动时同步的 Provider 列表（JSON 数组，可留空后在后台管理）
# 格式: [{"name":"xxx","baseUrl":"https://...","apiKey":"sk-...","models":["model-a"],"rule":"priority","priority":0}]
# rule 可选 priority/random/average，作用于该 priority 组
# 来源为 env 的 Provider 可在后台停用，但不可改连接信息、不可删除
FALLBACK_PROVIDERS=