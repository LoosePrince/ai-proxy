# 数据库连接（Supabase + Prisma 推荐配置）
# 运行时走 Transaction Pooler（6543），迁移走直连（5432）
DATABASE_URL=postgresql://postgres.onsrwidlogokohsxxzhm:[YOUR-PASSWORD]@aws-1-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require
DIRECT_URL=postgresql://postgres.onsrwidlogokohsxxzhm:[YOUR-PASSWORD]@db.onsrwidlogokohsxxzhm.supabase.co:5432/postgres?sslmode=require

# 服务端口
PORT=3000

# 管理后台账号（不设置则无需登录）
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Session 密钥（生产环境请更换）
SESSION_SECRET=ai-proxy-session-secret

# 响应超时默认值（管理后台里的全局配置会覆盖这些默认值）
DEFAULT_RESPONSE_TIMEOUT_MS=30000
PARALLEL_RESPONSE_TIMEOUT_MS=14000
FALLBACK_RESPONSE_TIMEOUT_MS=30000
# JSON 对象，key 为普通 Provider 的 priority，value 为毫秒数
PRIORITY_RESPONSE_TIMEOUTS={"0":20000,"1":35000}

# 启动时同步的普通 Provider 列表（JSON 数组，可不设）
# 格式: [{"name":"xxx","baseUrl":"https://...","apiKey":"sk-...","models":["model-a"],"rule":"priority","priority":0}]
# rule 可选 priority/random/average；全局路由、独立保底 Provider、独立并行 Provider 在管理后台配置
# env provider 可在后台关闭但不可删除
FALLBACK_PROVIDERS=